{
  "$schema": "vendor/infection/infection/resources/schema.json",
  "source": {
    "directories": [
      "src"
    ],
    "excludes": [
      "Testing"
    ]
  },
  "minCoveredMsi": 100,
  "minMsi": 100,
  "mutators": {
    "@default": true,
    "Ternary": {
      "ignoreSourceCodeByRegex": [
        ".*hasHeader \\? \\$reader->getRecords\\(\\) : \\$reader->getRecords\\(\\[\\]\\).*",
      ],
    },
    "Break_": {
      "ignore": [
        "Superscript\\Axiom\\Lookup\\LookupExtension::evaluate",
      ],
    },
    "FalseValue": {
      "ignoreSourceCodeByRegex": [
        ".*mapOr\\(false,.*=== false.*",
        ".*if \\(\\$stream === false\\).*",
      ],
    },
    "LogicalAnd": {
      "ignoreSourceCodeByRegex": [
        ".*is_numeric\\(\\$value\\) && is_numeric\\(\\$minValue\\) && is_numeric\\(\\$maxValue\\).*",
      ],
    },
    "LogicalAndAllSubExprNegation": {
      "ignoreSourceCodeByRegex": [
        ".*is_numeric\\(\\$value\\) && is_numeric\\(\\$minValue\\) && is_numeric\\(\\$maxValue\\).*",
      ],
    },
    "LogicalAndNegation": {
      "ignoreSourceCodeByRegex": [
        ".*is_numeric\\(\\$value\\) && is_numeric\\(\\$minValue\\) && is_numeric\\(\\$maxValue\\).*",
      ],
    },
    "LogicalAndSingleSubExprNegation": {
      "ignoreSourceCodeByRegex": [
        ".*is_numeric\\(\\$value\\) && is_numeric\\(\\$minValue\\) && is_numeric\\(\\$maxValue\\).*",
      ],
    },
    "GreaterThanOrEqualTo": {
      "ignoreSourceCodeByRegex": [
        ".*return Ok\\(\\$value >= \\$minValue && \\$value < \\$maxValue\\);.*",
      ],
    },
    "LessThan": {
      "ignoreSourceCodeByRegex": [
        ".*return Ok\\(\\$value >= \\$minValue && \\$value < \\$maxValue\\);.*",
      ],
    },
    "Finally_": {
      "ignore": [
        "Superscript\\Axiom\\Lookup\\LookupExtension::evaluate",
      ],
    },
    "UnwrapFinally": {
      "ignore": [
        "Superscript\\Axiom\\Lookup\\LookupExtension::evaluate",
      ],
    },
  },
  "logs": {
    "text": "build/infection.log",
  }
}
