{
    "name": "gosuperscript/axiom-lookup",
    "description": "Typed, streaming lookups over CSV, TSV, and other delimited files for Axiom.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "php",
        "csv",
        "tsv",
        "lookup",
        "projection",
        "streaming",
        "filtering"
    ],
    "require": {
        "php": "^8.4",
        "gosuperscript/axiom": "^0.6.6",
        "gosuperscript/monads": "^1.0.0",
        "league/csv": "^9.27.0",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "infection/infection": "^0.29.14",
        "laravel/pint": "^1.22",
        "phpbench/phpbench": "^1.3",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "12.5.11",
        "robiningelbrecht/phpunit-coverage-tools": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "Superscript\\Axiom\\Lookup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Superscript\\Axiom\\Lookup\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:types": "vendor/bin/phpstan analyse",
        "test:unit": "vendor/bin/phpunit -d --min-coverage=100",
        "test:infection": "vendor/bin/infection --threads=max --show-mutations",
        "test": [
            "@test:types",
            "@test:unit",
            "@test:infection"
        ],
        "bench": "vendor/bin/phpbench run --report=default",
        "bench:result": "vendor/bin/phpbench run --group=result --report=default",
        "bench:memory": "vendor/bin/phpbench run --group=memory --report=default"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
